<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SENAI - Conserto de Equipamentos</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <div class="flex h-screen">
        <div class="bg-[#2b4c9f] text-white w-64 flex flex-col">
            <div class="p-4"><div class="flex items-center gap-2 mb-6"><div class="w-10 h-10 bg-orange-500 rounded-full flex items-center justify-center text-xl">👤</div><div><div class="font-bold text-sm">Sistema</div><div class="text-xs opacity-80">Laboratórios</div></div></div></div>
            <nav class="flex-1 px-3 space-y-1">
                <a href="index.html" class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-blue-700"><span>🏠</span><span class="text-sm">Início</span></a>
                <a href="laboratorios.html" class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-blue-700"><span>🧪</span><span class="text-sm">Laboratórios</span></a>
                <a href="equipamentos.html" class="flex items-center gap-3 px-3 py-3 rounded-lg bg-blue-700"><span>💻</span><span class="text-sm">Equipamentos</span></a>
                <a href="cadastrar-usuario.html" class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-blue-700"><span>👥</span><span class="text-sm">Usuários</span></a>
                <a href="uso-laboratorios.html" class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-blue-700"><span>📅</span><span class="text-sm">Uso</span></a>
            </nav>
        </div>

        <div class="flex-1 flex flex-col">
            <header class="bg-white border-b px-6 py-4">
                <div class="flex items-center justify-between">
                    <div class="text-3xl font-bold text-[#2b4c9f]">SENAI</div>
                    <div class="flex-1 max-w-2xl mx-8"><input type="text" placeholder="🔍 Pesquisar" class="w-full px-4 py-2 border rounded-lg"></div>
                    <div class="flex items-center gap-4"><button>⚙️</button><button>🔔</button><div class="w-10 h-10 bg-orange-500 rounded-full flex items-center justify-center text-white">👤</div></div>
                </div>
            </header>

            <main class="flex-1 overflow-auto p-6">
                <div class="max-w-3xl mx-auto bg-white rounded-lg shadow-sm border p-8">
                    <div class="flex items-center gap-3 mb-6">
                        <span class="text-4xl">🔧</span>
                        <h1 class="text-2xl text-[#2b4c9f]">Conserto de equipamentos</h1>
                    </div>
                    <div class="text-sm text-gray-500 mb-6">Usuários / Conserto de equipamentos</div>

                    <form class="space-y-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Equipamento:</label>
                            <select class="w-full px-4 py-2 border rounded-lg">
                                <option>Selecione o equipamento</option>
                                <option>Arduino Uno</option>
                                <option>Impressora 3D</option>
                                <option>Osciloscópio Digital</option>
                                <option>PC Dell</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Laboratório:</label>
                            <div class="flex items-center gap-2 px-4 py-2 border rounded-lg bg-gray-50">
                                <span>🔧</span>
                                <span class="text-sm">Informática</span>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Descrição do problema:</label>
                            <textarea placeholder="Descreva o problema do equipamento..." rows="4" class="w-full px-4 py-2 border rounded-lg resize-none"></textarea>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-3">Prioridade:</label>
                            <div class="flex gap-6">
                                <label class="flex items-center gap-2">
                                    <input type="radio" name="prioridade" checked class="w-4 h-4">
                                    <span class="w-3 h-3 bg-blue-500 rounded-full"></span>
                                    <span class="text-sm">Baixa</span>
                                </label>
                                <label class="flex items-center gap-2">
                                    <input type="radio" name="prioridade" class="w-4 h-4">
                                    <span class="w-3 h-3 bg-gray-400 rounded-full"></span>
                                    <span class="text-sm">Média</span>
                                </label>
                                <label class="flex items-center gap-2">
                                    <input type="radio" name="prioridade" class="w-4 h-4">
                                    <span class="w-3 h-3 bg-red-400 rounded-full"></span>
                                    <span class="text-sm">Alta</span>
                                </label>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Foto do Problema:</label>
                            <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center">
                                <div class="text-6xl mb-3">📷</div>
                                <button type="button" class="text-sm text-[#2b4c9f] hover:underline">+ Adicionar Foto</button>
                                <div class="text-xs text-gray-500 mt-1">Clique para fazer upload</div>
                            </div>
                        </div>

                        <div class="flex justify-end gap-3 pt-6">
                            <a href="equipamentos.html" class="px-6 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Cancelar</a>
                            <button type="submit" class="px-6 py-2 bg-[#2b4c9f] text-white rounded-lg">Abrir chamado →</button>
                        </div>
                    </form>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
